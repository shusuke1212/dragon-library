  "records": [
    {
      "id": "tide-bells-1",
      "type": "灯台当番簿",
      "title": "潮待ち当番の引継ぎ",
      "snippet": "次の当番へ。鐘は満潮の一刻前に一度だけ。霧で船が見えなくても、二度は鳴らすな。二度の鐘は水門を開く合図だ。青い布が橋の側へ向いていたら、まず水位板を読んでほしい。",
      "required": true,
      "fieldClue": "次は「五連水道橋」へ。鐘楼と水路を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "crossing"
    },
    {
      "id": "tide-bells-2",
      "type": "水位台帳",
      "title": "橋脚の三本の線",
      "snippet": "上の線は去年の大潮。真ん中は堤を継ぎ足した年。いちばん下の赤線だけ、誰の印か分からなかった。泥を落とすと、線の隣に『下流の畑まで、あと半刻』とあった。これは街の水位を測る線ではない。",
      "required": true,
      "fieldClue": "同じ足場の反対側にも、もう一枚の記録がある。次は「干潟の家並み」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "tide-bells-3",
      "type": "船大工の覚書",
      "title": "底板を増やすな",
      "snippet": "浅瀬へ入る舟だから、重くしてはいけない。代わりに舷を高くする。注文は漁師ではなく、水門番の娘から来た。人を何人運ぶつもりだと聞くと、彼女は『乗れるだけ』と答えた。",
      "required": false,
      "fieldClue": "次は「干潟の家並み」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "tide-bells-4",
      "type": "未発送の手紙",
      "title": "家の戸に結んだ鍵",
      "snippet": "母さんへ。戸は閉めたけれど、鍵は青い布と一緒に外へ結びました。戻る時に誰かを待たせたくないから。鐘が二度鳴ったら、橋の向こうへ行きます。大きい舟には、荷物より子どもを先に乗せて。",
      "required": true,
      "fieldClue": "もう一方の色布の机にも、人の残した言葉がありそうだ。次は「沈鐘の水門」へ。鐘楼と水路を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "tide-bells-5",
      "type": "市会議事録",
      "title": "二つの岸の採決",
      "snippet": "堤が切れれば下流三村が流される。門を開けば、この街の低地は海になる。議決まで残り一刻。水門番は票を持たなかったが、地図の余白へ三村の戸数を書き込んだ。開門を可とする。鐘を二度鳴らす。",
      "required": true,
      "fieldClue": "次は「沈鐘の水門」へ。鐘楼と水路を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "tide-bells-6",
      "type": "水門の運転記録",
      "title": "最後の開門",
      "snippet": "第一歯車、正常。第二歯車、塩で固着。街側の逆流弁を外し、手回しに切り替える。開門後の閉鎖は不可能。記録者はここで交代する。前任者の字が震えていたので、名前は私が代筆した。",
      "required": true,
      "fieldClue": "次は「避難船の造船所」へ。鐘楼と水路を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "refuge"
    },
    {
      "id": "tide-bells-7",
      "type": "乗船名簿",
      "title": "空欄の行き先",
      "snippet": "船名の欄には、どの舟にも同じ『丘へ』が書かれている。出航先を書くはずの欄だが、ここでは舟を上陸場所まで引いたらしい。最後の欄外に、水門番と娘の二人分を追記。荷物なし。二人とも乗船。",
      "required": true,
      "fieldClue": "次は「丘の無音鐘」へ。高台の淡い灯を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "memorial"
    },
    {
      "id": "tide-bells-8",
      "type": "鐘守の書付",
      "title": "鳴らない鐘を残す",
      "snippet": "丘へ移した鐘には舌を入れなかった。街を失った日を、祝いの鐘にも警告の鐘にもしたくなかったから。潮底の鐘が時々鳴るのは、残った綱を海が引くせいだ。青い布は、帰ってきた者が毎年結び直す。",
      "required": true,
      "fieldClue": "次は「青布の灯台」へ。欠けた輪を頂く塔を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "tower"
    }
