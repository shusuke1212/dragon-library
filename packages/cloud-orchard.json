  "records": [
    {
      "id": "cloud-orchard-1",
      "type": "開花観測帳",
      "title": "咲いたのに実らない",
      "snippet": "今年も花は揃って咲いた。だが実は北端の三本にしか付かない。風の強さは平年並み。違っていたのは、低地から来る小さな虫を見なくなったことだ。高原で完結する果樹園など、最初からなかったのかもしれない。",
      "required": true,
      "fieldClue": "次は「風受けの並木」へ。高原の果樹と風受けを空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "crossing"
    },
    {
      "id": "cloud-orchard-2",
      "type": "風受けの調整票",
      "title": "風を止めすぎた庭",
      "snippet": "花を守るため、並木の風受けを高くした。虫も草の種も、そこで止まっていた。板を半分外すと若木の枝は折れたが、外から来るものが戻り始めた。守るための壁にも、季節ごとの開け方が要る。",
      "required": true,
      "fieldClue": "同じ足場の反対側にも、もう一枚の記録がある。次は「摘み手の集落」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "cloud-orchard-3",
      "type": "摘み手の歌の断片",
      "title": "袋は空でも",
      "snippet": "白い袋を枝へ、赤い袋を籠へ。空の袋は、花粉を少し隣へ。重たい袋は、谷の子どもへ。歌の続きを忘れた者がいたので、乾燥庫の戸の裏へ書いた。空袋にも仕事があることだけは、忘れないように。",
      "required": false,
      "fieldClue": "次は「摘み手の集落」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "cloud-orchard-4",
      "type": "共同収穫簿",
      "title": "最初の籠を渡す先",
      "snippet": "北端の三本から採れた果実を、売りには出さない。谷の苗床へ送り、種を取り出してもらう。今季の収入は減るが、ここにしかない木を、ここにしかないままにしておきたくない。受取り先の名は、枝札へも書く。",
      "required": true,
      "fieldClue": "もう一方の色布の机にも、人の残した言葉がありそうだ。次は「空樹の大庭」へ。高原の果樹と風受けを空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "cloud-orchard-5",
      "type": "接ぎ木師の便り",
      "title": "高い場所が好きとは限らない",
      "snippet": "この木が高原を好むのではなく、かつてここへ運んだ者が高原を好んだのだろう。谷の苗は低い枝から新芽を出した。品種の名へ土地の高さを閉じ込めず、育った場所を一つずつ記録してほしい。",
      "required": true,
      "fieldClue": "次は「空樹の大庭」へ。高原の果樹と風受けを空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "cloud-orchard-6",
      "type": "大庭の会合記録",
      "title": "囲いを開く年",
      "snippet": "風受けをすべて戻す案は否決。残す板と外す板を季節ごとに決め、谷の苗床にも観察を頼む。果樹園の管理人を一本の木の持ち主と同じにしない。実を摘む者、虫を数える者、種を運ぶ者で順番に務める。",
      "required": true,
      "fieldClue": "次は「種袋の乾燥庫」へ。高原の果樹と風受けを空から探し、色布の付いた机を調べよう。",
