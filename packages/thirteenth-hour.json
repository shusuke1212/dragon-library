  "records": [
    {
      "id": "thirteenth-hour-1",
      "type": "時計工の日報",
      "title": "同じ遅れ",
      "snippet": "塔も駅も工場も、同じ一時間だけ遅れている。歯車が同時に壊れるとは考えにくい。中央からの信号を切って、各時計の振り子を数えた。どれも正常だった。遅れは、機械が作ったものではない。",
      "required": true,
      "fieldClue": "次は「歯車の連絡橋」へ。歯車塔と逆向き時計を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "crossing"
    },
    {
      "id": "thirteenth-hour-2",
      "type": "連絡橋の通行票",
      "title": "人数のない列車",
      "snippet": "橋を渡った列車は空車扱い。だが車輪の跡は重く、停車時間も長かった。荷役の者は、車内で荷物を動かしたのではなく、足の悪い人を支えたと言った。集計へ入れないよう頼まれた人数だけ、誰も数えていない。",
      "required": true,
      "fieldClue": "同じ足場の反対側にも、もう一枚の記録がある。次は「計時工の長屋」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "thirteenth-hour-3",
      "type": "駅員の私記",
      "title": "切らなかった切符",
      "snippet": "切符のない乗客を乗せた。規則ではなく、今夜だけの判断だったと言われるのが怖い。だからここへ書く。次に同じことが起きた時も、扉を開ける理由が残るように。切符の代わりに、乗った者が互いの名を確かめた。",
      "required": false,
      "fieldClue": "次は「計時工の長屋」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "thirteenth-hour-4",
      "type": "計時工の往復書簡",
      "title": "針を止める依頼",
      "snippet": "中央時計を一時間止めてほしいとの依頼が来た。街の門は、交代の信号と同時に閉じる。その前に通せない人々がいるという。時間を止めても、夜が長くなるわけではない。止まるのは、門を閉める命令だけだ。",
      "required": true,
      "fieldClue": "もう一方の色布の机にも、人の残した言葉がありそうだ。次は「十二面の中央時計」へ。歯車塔と逆向き時計を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "thirteenth-hour-5",
      "type": "門衛の記録",
      "title": "閉門の印を待つ",
      "snippet": "交代の鐘は鳴らなかった。門外の者を中へ入れると、当直の席が足りなくなった。勤務表へ増やした『十三時』の欄に、私たちは皆で署名した。架空の時刻を作ったのは、誰か一人の手へ責任を押し付けないためだ。",
      "required": true,
      "fieldClue": "次は「十二面の中央時計」へ。歯車塔と逆向き時計を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "thirteenth-hour-6",
      "type": "中央時計の整備票",
      "title": "消した信号線",
