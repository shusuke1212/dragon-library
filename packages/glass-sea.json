  "records": [
    {
      "id": "glass-sea-1",
      "type": "巡路手帳",
      "title": "昼だけ見える道",
      "snippet": "砂の道は毎朝なくなる。だが光塔からの反射が、昼の間だけ同じ線を引く。道標の足跡は、通った者を写したものではなく、歩く向きを教えるために彫ったものだ。夕方は列柱の暗い側へ回ること。",
      "required": true,
      "fieldClue": "次は「緑硝子の列柱」へ。緑の結晶列と光塔を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "crossing"
    },
    {
      "id": "glass-sea-2",
      "type": "硝子工の配合表",
      "title": "声が聞こえる板",
      "snippet": "炉で冷えた板へ光を通すと、作業場の古い音が響いた。閉じ込めた魂だと客は言うが、私は板のひずみと風の関係を疑っている。同じ声が同じ順で繰り返されることを、誰も不思議がらなくなった。",
      "required": true,
      "fieldClue": "同じ足場の反対側にも、もう一枚の記録がある。次は「研磨師の宿場」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "glass-sea-3",
      "type": "旅人の走り書き",
      "title": "同じ返事",
      "snippet": "母に似た声を聞いた。何度呼んでも、返ってくるのは『棚の下にある』の一言だけだった。誰かがいま話しているのなら、名前を呼んでほしかった。列柱の足元に、声を聞く時は暗幕を掛けるよう札がある。",
      "required": false,
      "fieldClue": "次は「研磨師の宿場」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "glass-sea-4",
      "type": "注文控え",
      "title": "声の贈りもの",
      "snippet": "亡くなった者の声を売る注文は受けない。受けるのは、本人が読んだ短い便りを板へ写す仕事だけだ。この区別が宿場の外へ出ると消えてしまう。箱の表へ『返事はできません』と、大きく書くことにした。",
      "required": true,
      "fieldClue": "もう一方の色布の机にも、人の残した言葉がありそうだ。次は「記憶光の反射炉」へ。緑の結晶列と光塔を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "glass-sea-5",
      "type": "研磨師の手紙",
      "title": "削る前に読むこと",
      "snippet": "光を強くすれば記録が鮮明になると思っていた。だが強い熱は、古い層から順に声を消す。新しい祝詞を入れるために誰かの古い便りを削っていたことに、ようやく気付いた。削る前に、持ち主へ知らせてほしい。",
      "required": true,
      "fieldClue": "次は「記憶光の反射炉」へ。緑の結晶列と光塔を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "glass-sea-6",
      "type": "反射炉の停止票",
      "title": "増幅を止める",
      "snippet": "大祭へ向けた増幅を中止。消えた層は戻せないが、残る板の読み取りはできる。炉を閉じる理由を『危険な声が出たため』としないこと。危険だったのは、声ではなく、私たちが熱を加え続けたことだ。",
      "required": true,
      "fieldClue": "次は「暗幕の小屋」へ。緑の結晶列と光塔を空から探し、色布の付いた机を調べよう。",
