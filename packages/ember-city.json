  "records": [
    {
      "id": "ember-city-1",
      "type": "測温記録",
      "title": "温度の下がらない朝",
      "snippet": "主炉は止まったはずなのに、北の管だけ温度が下がらなかった。補助炉への燃料配分は零。計器を疑ったが、雪解け水もそこだけ湯気を立てている。送熱路の弁を、現場で確かめることにする。",
      "required": true,
      "fieldClue": "次は「双煙突の送熱路」へ。双煙突と送熱管を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "crossing"
    },
    {
      "id": "ember-city-2",
      "type": "配管修繕票",
      "title": "封じなかった枝管",
      "snippet": "主工場へ向かう弁を閉じ、診療所への枝管を残す。図面には廃管とあるが、実際にはまだ使われていた。誰が直したのか分からない継ぎ目が三か所ある。作業を終えたら、まず長屋へ知らせてほしい。",
      "required": true,
      "fieldClue": "同じ足場の反対側にも、もう一枚の記録がある。次は「炉工の長屋」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "ember-city-3",
      "type": "炉壁の落書き",
      "title": "八人目の休憩",
      "snippet": "交代は七人。なのに休憩用の椀は八つある。誰の分か聞くと、皆が次の班だと言った。夜に来る見習いが、班へ入る前から湯を飲めるようにしたらしい。椀を減らすくらいなら、灰の掃除を一つ増やす。",
      "required": false,
      "fieldClue": "次は「炉工の長屋」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "ember-city-4",
      "type": "労働者の申入れ",
      "title": "止める日を決める",
      "snippet": "炉壁の傷はもう補修の範囲を越えている。止めれば仕事を失うが、破れれば長屋も診療所も失う。停止後の賃金と住まいを先に決めてほしい。安全のためという言葉だけで、生活を灰にしないでほしい。",
      "required": true,
      "fieldClue": "もう一方の色布の机にも、人の残した言葉がありそうだ。次は「中央の休火炉」へ。双煙突と送熱管を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "ember-city-5",
      "type": "給金の支払簿",
      "title": "最後の賃金ではなく",
      "snippet": "停止後三月分の給金を先払いする。帳簿の表題を『退職金』としないこと。次の仕事へ移るまでの橋渡しである。職を残せなかった者の名も、省略しない。長屋の鍵は、支払いの有無に関わらず本人へ渡す。",
      "required": true,
      "fieldClue": "次は「中央の休火炉」へ。双煙突と送熱管を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "ember-city-6",
      "type": "中央炉の停止命令",
