  "records": [
    {
      "id": "rain-valley-1",
      "type": "量り番の日誌",
      "title": "雨量と届いた量",
      "snippet": "雨は増えているのに、村へ届く水は減っている。上流が取り過ぎたと皆は言う。だが塔の桶も、同じだけ減っている。空から来た量と、道を通って来た量を、同じ欄へ書いていたことから直さなければ。",
      "required": true,
      "fieldClue": "次は「七段の水道橋」へ。多段水路と雨受けを空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "crossing"
    },
    {
      "id": "rain-valley-2",
      "type": "水道橋の点検票",
      "title": "音が消える橋脚",
      "snippet": "第一橋脚では水が鳴る。第三でも鳴る。第五と第六の間だけ、夜中に音が薄くなる。見上げても割れ目は見えない。逆さの桶は空だという印ではなく、ここから先の量を量り直せという点検の印だった。",
      "required": true,
      "fieldClue": "同じ足場の反対側にも、もう一枚の記録がある。次は「桶守の村」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "rain-valley-3",
      "type": "桶守の手紙",
      "title": "隣の村を疑う前に",
      "snippet": "昨日、下の村の者が水を借りに来た。こちらも足りないので、盗んだのではないかと言いかけた。持ってきた桶の底は乾いていた。帰る前に二人で雨を受け、同じ高さまで溜まるのを待った。まず同じものを量ろう。",
      "required": false,
      "fieldClue": "次は「桶守の村」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "rain-valley-4",
      "type": "配水会議の記録",
      "title": "減らす順番",
      "snippet": "不足した分は末端の村から減らす、という慣例を廃止する案が出た。上流の取水量を増やしても届く量が変わらないためだ。今夜は全村で一刻だけ弁を閉じ、橋の下を歩いて音を聞く。争うための数字を、調べるために使いたい。",
      "required": true,
      "fieldClue": "もう一方の色布の机にも、人の残した言葉がありそうだ。次は「分水盤の大庭」へ。多段水路と雨受けを空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "rain-valley-5",
      "type": "村の共同帳",
      "title": "修理へ行く者の留守",
      "snippet": "橋の修理に出た家の畑は、隣の家が水をやる。水路を守る仕事と、自分の畑を守る仕事を選ばせないように。誰が何日働いたかは書くが、誰が多く水を貰うかを決める札にはしない。",
      "required": true,
      "fieldClue": "次は「分水盤の大庭」へ。多段水路と雨受けを空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "rain-valley-6",
      "type": "分水盤の裏書",
      "title": "弁を替えるだけではない",
      "snippet": "盤の目盛りは正しかった。第五橋脚の内側で、古い継ぎ目が夜の冷えに合わせて開いていた。弁を大きくしても、漏れる水が増えるだけだった。配り方の議論を止める必要はないが、壊れた道をそのままにして数字を争ってはならない。",
      "required": true,
      "fieldClue": "次は「漏水の作業小屋」へ。多段水路と雨受けを空から探し、色布の付いた机を調べよう。",
