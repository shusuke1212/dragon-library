  "records": [
    {
      "id": "verdant-observatory-1",
      "type": "観測野帳",
      "title": "春を迎えなかった星",
      "snippet": "暦では今日が播種の日。だが北の斜面にはまだ霜が残り、芽を数えても昨日と同じだった。星の位置は正しい。私たちが星へ付けた季節の名前の方が、土地から少しずつ離れているのではないか。",
      "required": true,
      "fieldClue": "次は「星環の回廊」へ。森の星環を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "crossing"
    },
    {
      "id": "verdant-observatory-2",
      "type": "環の修理票",
      "title": "ずらした目盛り",
      "snippet": "大天球儀の歯は欠けていない。星環の目盛りだけ、七日分ずらされていた。調整者の署名はない。元に戻すか迷い、いったん修理票を回廊の机へ置く。正しい目盛りが、正しい畑を作るとは限らない。",
      "required": true,
      "fieldClue": "同じ足場の反対側にも、もう一枚の記録がある。次は「暦師の集落」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "verdant-observatory-3",
      "type": "庭師の小帳",
      "title": "根の深さで覚える",
      "snippet": "年号は苦手なので、霜の深さと虫が戻った日を書くことにした。これは天文学ではない、と言われた。けれど暦を見ない小さな畑だけが、今年も芽を出した。来年は観測士にも、土を一握り持っていこう。",
      "required": false,
      "fieldClue": "次は「暦師の集落」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "verdant-observatory-4",
      "type": "暦の配給札",
      "title": "同じ日を売る仕事",
      "snippet": "種の配給は暦に合わせて一斉に行う。遅らせるには村ごとの申請が必要で、申請には次の暦が要る。父はこの仕事を誇りにしていた。私も、誰にでも同じ春が来ると思っていた。札の裏へ霜の日を書き始めたのは、その後だ。",
      "required": true,
      "fieldClue": "もう一方の色布の机にも、人の残した言葉がありそうだ。次は「緑陰の大天球儀」へ。森の星環を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "verdant-observatory-5",
      "type": "観測所の往復書簡",
      "title": "土を見た観測士",
      "snippet": "庭師の記録を受領した。北斜面と川沿いで同じ暦を使う方が誤りだった。星図の配布を止める必要はない。播種日を一つに決めるのを止めたい。星の位置の下に、土地ごとの余白を設けること。",
      "required": true,
      "fieldClue": "次は「緑陰の大天球儀」へ。森の星環を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
