  "records": [
    {
      "id": "winter-harbor-1",
      "type": "見張り日誌",
      "title": "三度目の点灯",
      "snippet": "船の出ない夜なのに、南灯が点いた。北灯は返事をしなかった。見張り小屋の古い表を見ると、二つの灯は帰港船ではなく、対岸から来る小舟へ向けたものだった。今夜は氷が薄い。灯を消す判断は朝まで待つ。",
      "required": true,
      "fieldClue": "次は「氷縁の桟橋」へ。凍った桟橋と双灯を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "crossing"
    },
    {
      "id": "winter-harbor-2",
      "type": "桟橋の作業票",
      "title": "重い荷を下ろす",
      "snippet": "出港予定の三隻から鉱石を全て下ろす。かわりに寝台、湯の樽、空の水袋を積む。港の収入は今季分失われる。積荷の変更命令は船主の署名で出たが、最初に寝台を運び込んだのは荷役の者たちだった。",
      "required": true,
      "fieldClue": "同じ足場の反対側にも、もう一枚の記録がある。次は「港番の長屋」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "winter-harbor-3",
      "type": "船室の落書き",
      "title": "窓を描く",
      "snippet": "窓のない寝台が怖いという子に、壁へ窓を描いた。外には白い雪しか見えないけれど、絵の窓には夏の港を描ける。帰りに消そうと思っていたが、船はこのまま南の港で使うらしい。絵も、乗せていこう。",
      "required": false,
      "fieldClue": "次は「港番の長屋」へ。家並みの色布と銅の輪を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "village"
    },
    {
      "id": "winter-harbor-4",
      "type": "港番宛の通信",
      "title": "対岸からの最後の便",
      "snippet": "山側の道が閉ざされ、対岸の集落に二百人が残る。救援船は凍結前に着けても、同じ道を戻れない。南の港へ抜ける航路だけはまだ開いている。帰港日を約束せず、来てくれる船を探している。",
      "required": true,
      "fieldClue": "もう一方の色布の机にも、人の残した言葉がありそうだ。次は「封鎖された連絡塔」へ。凍った桟橋と双灯を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "winter-harbor-5",
      "type": "組合の帳簿",
      "title": "帰り賃のない契約",
      "snippet": "三隻の船賃を、片道として支払う。乗員は救援後に南で新しい所属先を探すことになる。署名欄には全員の名があったが、二人だけ筆跡が同じだった。字を書けない者の名を、船長が読み上げながら代筆した。",
      "required": true,
      "fieldClue": "次は「封鎖された連絡塔」へ。凍った桟橋と双灯を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "center"
    },
    {
      "id": "winter-harbor-6",
      "type": "通信塔の受信紙",
      "title": "南港にて受領",
      "snippet": "三隻とも到着。対岸の住民と乗員を確認した。雪港へ向けた帰航は中止、船は住居と診療所として使用する。この紙を受け取ったら、待っている家へ知らせてほしい。船が戻らないことと、人が戻れないことを、一緒にしないで。",
      "required": true,
      "fieldClue": "次は「毛布の待合所」へ。凍った桟橋と双灯を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "refuge"
    },
    {
      "id": "winter-harbor-7",
      "type": "待合所の札",
      "title": "毛布を片づけない理由",
      "snippet": "ここで待つのは、帰港船ではない。対岸から氷を越えてくる遅れた者たちだ。最後の人が何人かは分からない。だから名簿の末尾を閉じず、毛布も畳んだまま置いておく。双灯が点いている間は、入ってよい。",
      "required": true,
      "fieldClue": "次は「迎え火の丘」へ。高台の淡い灯を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "memorial"
    },
    {
      "id": "winter-harbor-8",
      "type": "丘の灯台銘",
      "title": "帰らずの名の続き",
      "snippet": "この港から出た船は帰らなかった。その後、南の港から何通もの便りが届いた。ここでは船の名を灯へ移した。北灯は対岸へ、南灯は峠へ。帰港を待つ灯から、次に辿り着く者を迎える灯へ。",
      "required": true,
      "fieldClue": "次は「双灯の見張り台」へ。欠けた輪を頂く塔を空から探し、色布の付いた机を調べよう。",
      "hintTargetId": "tower"
    }
